{
  "name": "flowfi-e2e",
  "private": true,
  "scripts": {
    "build:web": "cd ../platform/frontend && flutter build web --release --dart-define=API_BASE_URL=http://127.0.0.1:8100 --output ../../e2e/.tmp/web",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test specs/auth.spec.ts",
    "list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
